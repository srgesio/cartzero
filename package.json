{
  "name": "cartzero",
  "version": "0.0.1",
  "description": "Ecommerce admin platform and pages without real finance transactions",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm services:up && turbo run dev",
    "services:up": "docker compose -f ./packages/database/compose.yaml up -d",
    "services:down": "docker compose -f ./packages/database/compose.yaml down",
    "services:stop": "docker compose -f ./packages/database/compose.yaml stop",
    "check-types": "turbo run check-types",
    "lint": "biome lint .",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest watch",
    "format": "biome format --write .",
    "check": "biome check .",
    "migration:create": "pnpm --filter @cartzero/database exec drizzle-kit generate",
    "migration:up": "pnpm --filter @cartzero/database exec drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.7.3",
    "typescript": "5.9.2",
    "ultracite": "5.1.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.6",
    "pg": "^8.23.1"
  }
}
